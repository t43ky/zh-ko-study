{
  "name": "zh-ko-study-app",
  "productName": "ZhKoStudy",
  "version": "1.4.3",
  "description": "중한 공부 번역기 - 데스크톱 앱",
  "main": "main.js",
  "author": "zh-ko-study",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac zip",
    "dist:linux": "electron-builder --linux AppImage",
    "sync-ocr": "node scripts/sync-ocr.js"
  },
  "build": {
    "appId": "local.zhko.study",
    "productName": "ZhKoStudy",
    "artifactName": "ZhKoStudy-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "updater.js"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "중한 공부 번역기",
      "createDesktopShortcut": true
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tesseract.js": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/t43ky/zh-ko-study.git"
  },
  "dependencies": {
    "jieba-wasm": "^2.4.0",
    "yauzl": "^3.4.0"
  }
}
