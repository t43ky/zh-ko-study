{
  "name": "zh-ko-study-app",
  "productName": "ZhKoStudy",
  "version": "1.8.1",
  "description": "중한 공부 번역기 - 데스크톱 앱",
  "main": "main.js",
  "author": "zh-ko-study",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:mac": "electron-builder --mac zip --arm64",
    "dist:linux": "electron-builder --linux AppImage",
    "sync-ocr": "node scripts/sync-ocr.js",
    "build-dict": "node scripts/build-dict.js",
    "build:mac-helper": "mkdir -p build/mac && swiftc -O -parse-as-library -target arm64-apple-macos14.4 native/mac/zhko-translate.swift -o build/mac/zhko-translate"
  },
  "build": {
    "appId": "local.zhko.study",
    "productName": "ZhKoStudy",
    "artifactName": "ZhKoStudy-${version}-${os}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json",
      "updater.js",
      "dict.js",
      "dict/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "중한 공부 번역기",
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.education",
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.4",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "선택한 글을 복사(⌘C)하기 위해 시스템 이벤트를 사용합니다.",
        "NSScreenCaptureUsageDescription": "화면에서 글자를 인식하기 위해 화면을 캡처합니다."
      },
      "extraResources": [
        {
          "from": "build/mac/zhko-translate",
          "to": "zhko-translate"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Education"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ]
  },
  "devDependencies": {
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tykok/cedict-dictionary": "^2.7.14",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "tesseract.js": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/t43ky/zh-ko-study.git"
  },
  "dependencies": {
    "jieba-wasm": "^2.4.0",
    "yauzl": "^3.4.0"
  }
}
